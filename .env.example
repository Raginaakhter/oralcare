# Copy this file to .env.local and fill in your real values.
# .env* files are gitignored — never commit secrets.

# Public site URL — used for SEO metadata, sitemap.xml and robots.txt.
# NEXT_PUBLIC_* vars are embedded in the client bundle.
NEXT_PUBLIC_SITE_URL=https://oralcarebd.com

# Cloudinary (used by scripts/upload-cloudinary.mjs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
