# Copy this file to .env.local and fill in your real values.
# .env* files are gitignored — never commit secrets.

# Public site URL — used for SEO metadata, sitemap.xml and robots.txt.
# NEXT_PUBLIC_* vars are embedded in the client bundle.
NEXT_PUBLIC_SITE_URL=https://oralcarebd.com

# OralCare backend origin (no trailing slash, without /api/v1).
# The backend must list this site's origin in CLIENT_URL for CORS + the refresh-token cookie.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Cloudinary (used by scripts/upload-cloudinary.mjs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
